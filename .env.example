# Postgres connection string (Neon)
DATABASE_URL=

# Id (user.id) of the portfolio owner shown on the public pages
USER_ID=

# better-auth secret, e.g. generated with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. http://localhost:3000
BETTER_AUTH_URL=

# Cloudflare R2 (upload de imagens pelo admin)
R2_ACCOUNT_ID=
# Token com permissão "Object Read & Write" só no bucket abaixo
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública do bucket (domínio próprio ou r2.dev), sem barra no fim,
# ex.: https://img.seudominio.com
NEXT_PUBLIC_R2_PUBLIC_URL=
